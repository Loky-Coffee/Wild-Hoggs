# ============================================
# WILD HOGGS - SECURITY & CACHING HEADERS
# Cloudflare Pages Configuration
# ============================================

# Global Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()
  # script-src ohne 'unsafe-inline': Die Inline-Skripte, die Astro fuer Hydration
  # und ClientRouter erzeugt, stehen als Pruefsumme drin. scripts/write-csp-hashes.mjs
  # traegt sie nach jedem Build anstelle von {{SCRIPT_HASHES}} ein — beim Aendern
  # eines Inline-Skripts aendert sich die Pruefsumme automatisch mit.
  # style-src behaelt 'unsafe-inline': Preact setzt style="..."-Attribute (Fortschritts-
  # balken, Diagramme), und dafuer helfen Pruefsummen nicht.
  # cloudflareinsights.com: Cloudflare injiziert automatisch beacon.min.js auf allen CF Pages-Sites.
  # Das ist First-Party (eigener Hosting-Provider), kein Drittanbieter → sicher whitelisted.
  # wss://wild-hoggs-chat-hub...: der Live-Chat-Hub (eigener Worker, Verzeichnis chat-hub/).
  # Nur dieser eine Host, nur ueber wss — ohne den Eintrag blockiert die CSP die
  # WebSocket-Verbindung und der Chat faellt auf Polling zurueck.
  # ACHTUNG, falls jemals Besucher ausgesperrt werden:
  # Cloudflare spritzt in jede HTML-Antwort ein Inline-Skript seiner
  # Bot-Erkennung (/cdn-cgi/challenge-platform/scripts/jsd/). Dessen Inhalt
  # enthaelt eine Anfrage-Kennung und einen Zeitstempel, ist also bei jedem
  # Aufruf anders — eine Pruefsumme dafuer gibt es nicht, und Cloudflares
  # empfohlener Weg (nonce) scheitert an statisch gebauten Seiten. Das Skript
  # wird deshalb blockiert: ein Eintrag in der Browser-Konsole je Seitenaufruf,
  # kein cf_clearance-Cookie. Fuer Besucher folgenlos, solange keine WAF-Regel
  # auf cf.bot_management.js_detection.passed prueft (Stand 13.08.2026: keine).
  # Abschalten laesst es sich hier nicht — im Free-Tarif haengt es fest an
  # Bot Fight Mode, auch wenn der aus ist.
  # Sollte Cloudflare das aendern (etwa "Precursor" im Modus Maximize Security,
  # der ein gueltiges cf_clearance verlangt) und echte Besucher stehen vor
  # verschlossener Tuer: In der zweiten Zeile unten die Pruefsummen durch
  # 'unsafe-inline' ersetzen. Das nimmt den Schutz zurueck, aber oeffnet sofort.
  #
  # Zwei Richtlinien, und das mit Absicht: Ein Skript muss BEIDE erfuellen, also
  # gilt die jeweils strengere. Cloudflare Pages erlaubt pro Header-Zeile nur
  # 2000 Zeichen (developers.cloudflare.com/pages/platform/limits/#headers), und
  # die Pruefsummen allein brauchen schon rund 1500. Zusammen mit dem Rest waere
  # die Grenze in Sicht — getrennt hat jede Zeile Luft.
  # Die erste Zeile regelt alles ausser Skripten und laesst 'unsafe-inline'
  # stehen; wirksam ist dort die zweite Zeile, die nur die Pruefsummen erlaubt.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://static.cloudflareinsights.com wss://wild-hoggs-chat-hub.alatzas5564.workers.dev; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Content-Security-Policy: script-src 'self' {{SCRIPT_HASHES}} https://static.cloudflareinsights.com
  # levelgeeks.org wurde entfernt - alle Bilder sind self-hosted
  Strict-Transport-Security: max-age=15552000; includeSubDomains; preload

# OG Images - Cache 30 Tage (immutable)
/og-*.webp
  Cache-Control: public, max-age=2592000, immutable

# Static Assets - Cache 1 Jahr (immutable)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

# Images - Cache 30 Tage
/images/*
  Cache-Control: public, max-age=2592000

# ── HTML-Seiten ─────────────────────────────────────────────────────────────
#
# Die frühere Regel lautete /*.html und griff dadurch nur bei der Startseite:
# Mit trailingSlash: 'always' heissen die Adressen /de/ oder /de/tools/tank/,
# also ohne Dateiendung. Gemessen lieferte Cloudflare für 540 der 541 Seiten
# "max-age=0" und "cf-cache-status: DYNAMIC" — jeder Aufruf holte das komplette
# HTML neu vom Ursprung, ohne Zwischenspeicher und ohne ETag.
#
# max-age=300: Beim Klick im Menü ist die Seite sofort da, ohne Netzanfrage.
# Vorher stand hier 0 — dadurch holte der Browser bei JEDEM Menüklick die
# vollständige Seite neu, gemessen 176 ms je Navigation.
#
# Fünf Minuten sind bewusst kurz gewählt. Das ausgelieferte HTML ist statisch;
# alles, was sich ändert — Gift-Codes, Chat, Profil — kommt über die
# Schnittstellen und ist davon unberührt. Nach einem Deploy sieht jemand also
# höchstens fünf Minuten lang die vorige Fassung, und die Versionsmeldung
# greift ohnehin (version.json ist weiter unten ausgenommen).
#
# s-maxage=300 statt 3600, und das ist kein Schönheitsfehler: Seit im
# Dashboard eine Cache Rule aktiv ist, räumt ein Pages-Deploy den
# Netzrand-Zwischenspeicher NICHT mehr aus. Gemessen wurden 16 Minuten nach
# einem Deploy noch Seiten mit age=978s ausgeliefert — also der Stand von
# davor. Mit 3600 hätten Besucher bis zu einer Stunde die alte Fassung
# gesehen; mit 300 sind es höchstens fünf Minuten, dieselbe Spanne wie beim
# Browser.
#
# Bewusst NICHT als /* geschrieben: Unter /api/ liegen Antworten mit
# Kontodaten, Meldungen und Gift-Codes. Die tragen zwar inzwischen alle
# "no-store" (siehe functions/api/), doch eine Regel, die sie überhaupt erst
# erfassen könnte, hat hier nichts zu suchen.
/
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate

/de/*
  Cache-Control: public, max-age=300, s-maxage=300, must-revalidate

