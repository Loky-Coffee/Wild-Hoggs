---
import { getLangFromUrl, useTranslations, nurBereiche } from '../i18n/utils';
import { loadTranslations } from '../i18n/index';
import type { TranslationKey } from '../i18n/index';
import LanguageDropdown from './LanguageDropdown.astro';
import ApocalypseTimeClock from './ApocalypseTimeClock';
import UserMenu from './auth/UserMenu';
import PresenceHeartbeat from './chat/PresenceHeartbeat';
import GlobalChatPoller from './chat/GlobalChatPoller';
import UpdateNotice from './UpdateNotice';

const lang = getLangFromUrl(Astro.url);
const translationData = await loadTranslations(lang);
const t = useTranslations(translationData);

// Helper to generate paths: English without prefix, others with prefix
// Always include trailing slash to avoid 308 redirects from Cloudflare Pages
const getPath = (page: string) => {
  if (lang === 'en') {
    return page === 'home' ? '/' : `/${page}/`;
  }
  return page === 'home' ? `/${lang}/` : `/${lang}/${page}/`;
};

// Die vier Rechner stehen direkt hier, nicht mehr hinter einem Sammelpunkt
// "Rechner". Sie sind der Grund, warum die meisten Leute die Seite aufrufen —
// ein Klick weniger.
//
// "Startseite" steht nur noch auf schmalen Bildschirmen im Menue (nurMobil).
//
// Am Rechner fuehrt der Schriftzug "Wild Hoggs" links dorthin, so wie auf
// nahezu jeder Website — ein eigener Menuepunkt waere doppelt und kostet
// Platz, den die vier Rechner jetzt brauchen. Auf dem Handy ist der Schriftzug
// aber ausgeblendet (siehe .nav-brand im @media-Block unten, dort ist die
// Zeile knapp: [Anmelden] [≡] [Flagge]). Ohne diesen Eintrag gaebe es dort
// ueberhaupt keinen Weg zurueck zur Startseite.
//
// Die Adressen bleiben, wie sie sind. Es aendert sich nur, worauf das Menue
// zeigt — /tools/ selbst bleibt bestehen, ist ueber die Brotkrumen jeder
// Rechnerseite verlinkt und behaelt damit ihre Position bei Google.
const routes = [
  { key: 'nav.home', path: getPath('home'), nurMobil: true },
  { key: 'nav.research', path: getPath('tools/research') },
  { key: 'nav.building', path: getPath('tools/building') },
  { key: 'nav.tank',     path: getPath('tools/tank') },
  { key: 'nav.caravan',  path: getPath('tools/caravan') },
  { key: 'nav.codes', path: getPath('codes'), gruppenAnfang: true },
  { key: 'nav.roses', path: getPath('roses') },
  { key: 'nav.heroes', path: getPath('heroes') },
  { key: 'nav.community', path: getPath('community') },
  { key: 'nav.about', path: getPath('about') },
] as { key: TranslationKey; path: string; nurMobil?: boolean; gruppenAnfang?: boolean }[];

// Normalize to trailing slash for comparison (keeps '/' as-is)
const rawPath = Astro.url.pathname;
const currentPath = rawPath === '/' ? '/' : (rawPath.endsWith('/') ? rawPath : rawPath + '/');
---

<!-- Benannt, weil die Seite drei nav-Landmarken hat: beim Sprung von
     Landmarke zu Landmarke waren sie sonst nicht zu unterscheiden. -->
<nav class="navigation" aria-label={t('a11y.mainNav')}>
  <div class="nav-container">
    <div class="nav-brand">
      <a href={getPath('home')}>
        <span class="brand-text">Wild Hoggs</span>
      </a>
    </div>

    <button class="nav-toggle" aria-label={t('a11y.toggleNav')} aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <ul class="nav-links">
      {routes.map(({ key, path, nurMobil, gruppenAnfang }) => (
        <li class:list={{ 'nur-mobil': nurMobil, 'gruppen-anfang': gruppenAnfang }}>
          <a
            href={path}
            class:list={['nav-link', { active: currentPath === path }]}
          >
            {t(key)}
            {key === 'nav.community' && (
              <span id="community-badge" class="nav-badge" style="display:none"></span>
            )}
          </a>
        </li>
      ))}
    </ul>

    {/*
      transition:persist — diese Inseln überleben den Seitenwechsel.

      Ohne das wurden bei JEDEM Menüklick alle fünf abgebaut und neu erzeugt:
      Uhr-Timer neu setzen, Chat-Verbindung neu aufbauen, Präsenz-Ping neu
      anmelden, Ankündigung erneut abfragen. Gemessen schlug das als
      Darstellungsverzögerung durch — 645 ms von 744 ms bei der schlechtesten
      Interaktion, während die Verarbeitung selbst nur 96 ms brauchte.

      Die Namen der beiden Inseln mit Texten tragen die Sprache: Beim Wechsel
      von Deutsch auf Englisch ändert sich der Name, die Insel wird verworfen
      und mit den richtigen Texten neu aufgebaut. Ohne diesen Zusatz bliebe im
      Menü die alte Sprache stehen.
    */}
    <div class="nav-controls">
      <ApocalypseTimeClock client:idle transition:persist="apo-uhr" />
      <UserMenu
        {/* Bereiche statt Einzelliste: USER_MENU_KEYS zaehlte dreizehn Schluessel
            auf — genug fuer das Menue selbst, aber das Menue oeffnet den
            Anmeldedialog, und der braucht neunzehn eigene. Live standen dort
            deshalb rohe Schluesselnamen ("auth.password" statt "Passwort") vor
            jedem, der sich anmelden oder registrieren wollte.
            scripts/check-i18n-bereiche.mjs folgt den Importen und faengt so
            etwas jetzt vor dem Build ab. */}
        translationData={nurBereiche(translationData, ['auth.', 'profile.'])}
        client:only="preact"
        transition:persist={`user-menu-${lang}`}
      />
      <PresenceHeartbeat client:only="preact" transition:persist="presence" />
      <GlobalChatPoller client:only="preact" transition:persist="chat-poller" />
      <UpdateNotice
        label={t('update.available')}
        hint={t('update.hint')}
        action={t('update.reload')}
        later={t('update.later')}
        close={t('update.close')}
        client:idle
        transition:persist={`update-notice-${lang}`}
      />
    </div>

    <div class="lang-switcher">
      <LanguageDropdown />
    </div>
  </div>
</nav>

<style>
  .navigation {
    background: rgba(26, 26, 26, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid rgba(255, 165, 0, 0.3);
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 1000;
  }

  .nav-container {
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-brand a {
    text-decoration: none;
    color: #ffa500;
    font-size: 1.5rem;
    font-weight: bold;
    display: flex;
    align-items: center;
    transition: color 0.3s ease;
  }

  .nav-brand a:hover {
    color: #ff8c00;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .nav-toggle span {
    width: 25px;
    height: 3px;
    background: #ffa500;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  /* Am Rechner fuehrt der Schriftzug zur Startseite, hier waere der Punkt
     doppelt. Auf dem Handy ist der Schriftzug ausgeblendet — dort ist dieser
     Eintrag der einzige Heimweg (siehe @media unten). */
  .nav-links li.nur-mobil {
    display: none;
  }

  /* Enger als frueher: Mit neun Punkten statt sieben brauchte die Leiste
     1616 px und schob auf allem unter 1920 px einen waagerechten Scrollbalken
     ins Bild. Mit diesen Abstaenden passt sie ab 1280 px. */
  /* Alle Punkte gleich breit: Sie teilen sich den vorhandenen Platz zu
     gleichen Teilen (flex: 1 1 0). Damit ist die Leiste gleichmaessig, egal
     wie lang die einzelnen Woerter sind. */
  .nav-links {
    display: flex;
    align-items: stretch;
    list-style: none;
    gap: 6px;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .nav-links li {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
  }

  /* Die vier Rechner und die uebrigen Seiten: nur etwas mehr Luft dazwischen. */
  .nav-links li.gruppen-anfang {
    margin-left: 0.6rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    text-align: center;
    text-decoration: none;
    color: #ffcc80;
    /* 0.8rem statt 0.85: Bei gleich breiten Kaesten richtet sich alles nach
       dem laengsten Wort — "Investigación" (es), "私たちについて" (ja) und die
       arabischen Punkte mit Artikel passten sonst nicht und wurden
       abgeschnitten. */
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.45rem 0.25rem;
    white-space: nowrap;
    border-radius: 8px;
    border: 1px solid rgba(255, 165, 0, 0.28);
    background: linear-gradient(180deg, rgba(255, 165, 0, 0.1) 0%, rgba(255, 165, 0, 0.03) 100%);
    box-shadow: inset 0 1px 0 rgba(255, 200, 120, 0.12);
    transition: color 0.18s ease, background 0.18s ease, border-color 0.18s ease,
                box-shadow 0.18s ease, transform 0.18s ease;
    position: relative;
  }

  .nav-link:hover {
    color: #fff;
    border-color: rgba(255, 165, 0, 0.7);
    background: linear-gradient(180deg, rgba(255, 165, 0, 0.28) 0%, rgba(255, 165, 0, 0.12) 100%);
    box-shadow: 0 3px 14px rgba(255, 165, 0, 0.28), inset 0 1px 0 rgba(255, 220, 160, 0.2);
    transform: translateY(-1px);
  }

  .nav-link:active {
    transform: translateY(0);
  }

  /* Die Seite, auf der man gerade steht: voll gefuellt, dunkle Schrift. */
  .nav-link.active {
    color: #1c1206;
    font-weight: 700;
    border-color: #ffa500;
    background: linear-gradient(180deg, #ffc046 0%, #ff9500 100%);
    box-shadow: 0 3px 14px rgba(255, 165, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .nav-link.active:hover {
    color: #1c1206;
    background: linear-gradient(180deg, #ffcb5e 0%, #ffa016 100%);
  }

  .nav-badge {
    position: absolute;
    top: 0px;
    right: 0px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 8px;
    background: #e74c3c;
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
    pointer-events: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .lang-switcher {
    display: flex;
    align-items: center;
    margin-left: 0.5rem;
  }

  /* 1440 statt 768: Weil alle neun Schaltflaechen gleich breit sind, richtet
     sich die noetige Breite nach dem laengsten Wort — und das steht nicht im
     Deutschen. Nachgemessen ueber alle fuenfzehn Sprachen: "Investigación"
     (es), "私たちについて" (ja) und "Communauté" (fr) passen ab 1440 px, bei
     1366 wurden sie abgeschnitten. Darunter uebernimmt das Klappmenue.
     Wer hier Punkte hinzufuegt oder umbenennt, muss diesen Wert nachmessen. */
  @media (max-width: 1440px) {
    .navigation {
      position: sticky;
      top: 0;
      width: 100%;
      z-index: 1000;
      --mobile-nav-height: 62px;
    }

    .nav-container {
      padding: 0.75rem 1rem;
      gap: 0;
      flex-wrap: nowrap;
      position: relative;
      justify-content: space-between;
    }

    .nav-brand {
      display: none;
    }

    /* Der Schriftzug ist hier weg, also braucht das Menue den Heimweg. */
    .nav-links li.nur-mobil {
      display: block;
    }

    /* Untereinander gelten andere Regeln: Der Traeger der Leiste wuerde hier
       nur einen Kasten um die ganze Liste ziehen. */
    .nav-links li {
      display: block;
    }

    .nav-links li.gruppen-anfang {
      margin-left: 0;
      border-top: 1px solid rgba(255, 165, 0, 0.18);
    }

    /* Mobile: [UserMenu (flex:1)] [≡] [flag] */
    .nav-controls {
      order: 1;
      flex: 1;
      gap: 0.5rem;
    }

    .nav-toggle {
      display: flex;
      order: 2;
      flex: 0 0 auto;
    }

    .lang-switcher {
      order: 3;
      flex: 0 0 auto;
      margin-left: 0.5rem;
    }

    /* Uhr auf Mobile ausblenden — zu breit für kleine Screens */
    .nav-controls :global(.apocalypse-clock) {
      display: none;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;
      flex-direction: column;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-in-out;
      background: rgba(26, 26, 26, 0.98);
      margin: 0;
      padding: 0;
      /* Der Traeger der Desktop-Leiste hat hier nichts verloren: Er wuerde
         einen abgerundeten Kasten um das ganze Klappmenue ziehen. */
      border: none;
      border-top: 2px solid rgba(255, 165, 0, 0.3);
      border-radius: 0;
      box-shadow: none;
    }

    .nav-links.open {
      max-height: 600px;
      overflow-y: auto;
    }

    .nav-links li {
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(255, 165, 0, 0.15);
      border-radius: 0;
      text-align: left;
      box-sizing: border-box;
      box-shadow: none;
    }

    .nav-link.active {
      background: rgba(255, 165, 0, 0.12);
      border-left: 3px solid #ffa500;
      padding-left: calc(1.5rem - 3px);
      box-shadow: none;
    }
  }
</style>

<script>
  const navClickHandlers = new WeakMap<Element, EventListener>();
  const navLinkHandlers = new WeakMap<Element, EventListener>();

  function setupNavToggle() {
    const toggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');

    if (!toggle || !navLinks) return;

    // Remove old listener if exists (prevent duplicates)
    const oldHandler = navClickHandlers.get(toggle);
    if (oldHandler) {
      toggle.removeEventListener('click', oldHandler);
    }

    // Create new click handler
    const clickHandler = () => {
      const isOpen = navLinks.classList.toggle('open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    };

    // Store handler reference for cleanup
    navClickHandlers.set(toggle, clickHandler);

    // Add new listener
    toggle.addEventListener('click', clickHandler);

    // Shared close helper
    const closeMenu = () => {
      navLinks.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
    };

    // Close menu when clicking a nav link
    document.querySelectorAll('.nav-link').forEach(link => {
      const oldLinkHandler = navLinkHandlers.get(link);
      if (oldLinkHandler) {
        link.removeEventListener('click', oldLinkHandler);
      }
      link.addEventListener('click', closeMenu);
      navLinkHandlers.set(link, closeMenu as EventListener);
    });

    registerOutsideClick();
  }

  // Close menu when clicking outside.
  // WICHTIG: genau EINMAL pro Seiten-Session registrieren und die Elemente erst
  // im Handler auflösen. Eine per-Element gespeicherte Referenz (WeakMap) taugt
  // hier nicht: nach einer View Transition tauscht Astro den <body> aus, das
  // .nav-toggle ist danach ein neues Objekt, die WeakMap trifft nicht mehr und
  // der alte document-Listener bliebe für immer hängen — samt dem kompletten
  // alten Seiten-DOM, das seine Closure festhält.
  function registerOutsideClick() {
    if ((window as any).__whNavOutsideClick) return;
    (window as any).__whNavOutsideClick = true;

    document.addEventListener('click', (e) => {
      const links  = document.querySelector('.nav-links');
      const button = document.querySelector('.nav-toggle');
      if (!links || !button || !links.classList.contains('open')) return;
      const target = e.target as HTMLElement;
      if (!links.contains(target) && !button.contains(target)) {
        links.classList.remove('open');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Run on initial page load (once: true — DOMContentLoaded fires only once anyway)
  document.addEventListener('DOMContentLoaded', setupNavToggle, { once: true });

  // Run on every View Transition navigation
  document.addEventListener('astro:page-load', setupNavToggle);
</script>
