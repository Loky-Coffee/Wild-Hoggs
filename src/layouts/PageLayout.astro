---
import Layout from './Layout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, nurBereiche } from '../i18n/utils';
import { loadTranslations } from '../i18n/index';
import Navigation from '../components/Navigation.astro';
import VerifyBanner from '../components/auth/VerifyBanner';
import Breadcrumbs from '../components/Breadcrumbs.astro';

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  robots?: string;
  breadcrumbs?: BreadcrumbItem[];
  image?: string;
  imageAlt?: string;
  fullWidth?: boolean;
  /**
   * Kein Fussbereich. Fuer Ansichten, die den Bildschirm ausfuellen — der Chat
   * und der Verwaltungsbereich. Dort schiebt ein Fussbereich den Inhalt nach
   * oben und haengt unter dem Eingabefeld, was die Ansicht zerreisst.
   *
   * Zur Zugaenglichkeit der Datenschutzerklaerung: Beide Ansichten sind
   * noindex und nur angemeldet erreichbar, und die Navigationsleiste bleibt
   * ueberall stehen — ein Klick fuehrt auf eine Seite mit Fussbereich. Art. 12
   * DSGVO verlangt "leicht zugaenglich", nicht "auf jedem Bildschirm sichtbar".
   */
  ohneFuss?: boolean;
}

const {
  title, description, robots, breadcrumbs, image, imageAlt,
  fullWidth = false, ohneFuss = false,
} = Astro.props;

// Der Sprungverweis stand fest auf Englisch — ausgerechnet das Erste, was ein
// Tastatur- oder Screenreader-Benutzer auf jeder der 495 Seiten antrifft.
const lang = getLangFromUrl(Astro.url);
const translationData = await loadTranslations(lang);
const t = useTranslations(translationData);
---

<Layout title={title} description={description} robots={robots} image={image} imageAlt={imageAlt}>
  <a href="#main-content" class="skip-link">{t('a11y.skipToContent')}</a>
  <Navigation />

  {/* Erscheint nur bei angemeldeten Konten mit unbestaetigter Adresse und
      entscheidet das selbst — hier steht keine Bedingung, weil der Server die
      Seiten statisch baut und nicht weiss, wer sie aufruft.
      client:idle statt client:visible: Der Balken steht ganz oben und waere
      sofort sichtbar, dann kaeme "visible" einem sofortigen Laden gleich —
      nur mit dem Umweg ueber den Beobachter. */}
  <VerifyBanner translationData={nurBereiche(translationData, ['verify.'])} client:idle />

  {breadcrumbs && breadcrumbs.length > 0 && (
    <div class="breadcrumbs-container">
      <Breadcrumbs items={breadcrumbs} />
    </div>
  )}
  <main id="main-content" class:list={['page-content', { 'page-content--full': fullWidth }]}>
    <slot />
  </main>

  {/* Fussbereich mit den rechtlichen Verweisen. Die Datenschutzerklaerung muss
      "leicht zugaenglich" sein (Art. 12 DSGVO) — von jeder Seite aus, nicht
      versteckt. Deshalb hier und nicht nur im Menue.

      Ausgenommen sind Ansichten mit ohneFuss: der Chat und der
      Verwaltungsbereich. Beide fuellen den Bildschirm; darunter angehaengt
      zerreisst der Fussbereich die Ansicht. */}
  {!ohneFuss && (
  <footer class="seiten-fuss">
    <nav aria-label={lang === 'de' ? 'Rechtliches' : 'Legal'}>
      <a href={getLocalizedPath('privacy', lang)}>
        {lang === 'de' ? 'Datenschutz' : 'Privacy'}
      </a>
      <span aria-hidden="true">·</span>
      <a href={getLocalizedPath('about', lang)}>{t('nav.about')}</a>
    </nav>
    <p class="fuss-hinweis">
      {lang === 'de'
        ? 'Private Fanseite. Nicht mit den Entwicklern von Last Z: Survival Shooter verbunden.'
        : 'Private fan site. Not affiliated with the developers of Last Z: Survival Shooter.'}
    </p>
  </footer>
  )}
</Layout>

<style>
  .seiten-fuss {
    max-width: 1100px;
    margin: 3rem auto 0;
    padding: 1.2rem 1rem 2rem;
    border-top: 1px solid rgba(255, 165, 0, 0.15);
    text-align: center;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .seiten-fuss nav {
    display: flex;
    justify-content: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .seiten-fuss a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
  }

  .seiten-fuss a:hover { color: #ffa500; }

  .fuss-hinweis {
    margin: 0.6rem 0 0;
    color: rgba(255, 255, 255, 0.42);
  }

  /* Skip Navigation Link - Accessibility */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--color-primary);
    color: #000;
    padding: 8px 16px;
    text-decoration: none;
    font-weight: 600;
    border-radius: 0 0 4px 0;
    z-index: 10000;
    transition: top 0.2s ease;
  }

  .skip-link:focus {
    top: 0;
  }

  .breadcrumbs-container {
    position: sticky;
    top: var(--nav-height);
    background: rgba(26, 26, 26, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 165, 0, 0.2);
    padding: 0.5rem 2rem;
    z-index: 999;
  }

  .page-content {
    max-width: 100%;
    margin: 0 auto;
    padding: 0.5rem 2rem 2rem;
    overflow-x: clip; /* clip statt hidden: verhindert horizontalen Scroll ohne Scroll-Context zu erzeugen */
  }

  .page-content--full {
    padding: 0;
    overflow: hidden;
    width: 100%;   /* überschreibt max-width:100% — explizit volle Breite */
    margin: 0;     /* überschreibt margin:0 auto — auto-Margins würden in Flex zentrieren statt strecken */
  }

  @media (max-width: 768px) {
    .breadcrumbs-container {
      top: var(--nav-height-mobile);
      padding: 0.4rem 1rem;
    }

    .page-content {
      padding: 0.5rem 1rem 3rem;
    }

    .page-content--full {
      padding: 0;
    }
  }
</style>
