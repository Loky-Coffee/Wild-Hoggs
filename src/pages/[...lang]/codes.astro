---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations, getCurrentMonth, getCurrentYear, getLocalizedPath } from '../../i18n/utils';
import { getLanguagePaths } from '../../i18n/static-paths';
import { loadTranslations } from '../../i18n/index';
import RewardCodesLocal, { giftCenterUrl } from '../../components/RewardCodesLocal';
import '../../styles/shared-layouts.css';

export function getStaticPaths() {
  return getLanguagePaths();
}

const lang = getLangFromUrl(Astro.url);
const translationData = await loadTranslations(lang);
const t = useTranslations(translationData);
const currentMonth = getCurrentMonth(lang);
const currentYear = getCurrentYear();

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('', lang) },
  { label: t('nav.codes') }
];

// HowTo Schema for SEO
const siteUrl = Astro.site || new URL('https://wild-hoggs.com/');
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': t('codes.howto.title'),
  'description': t('seo.codes.description', { month: currentMonth, year: currentYear }),
  'image': new URL('/og-image.webp', siteUrl).toString(),
  'totalTime': 'PT2M',
  'step': [
    {
      '@type': 'HowToStep',
      'name': t('codes.howto.step1'),
      'text': t('codes.howto.step1'),
      'position': 1
    },
    {
      '@type': 'HowToStep',
      'name': t('codes.howto.step2'),
      'text': t('codes.howto.step2'),
      'position': 2
    },
    {
      '@type': 'HowToStep',
      'name': t('codes.howto.step3'),
      'text': t('codes.howto.step3'),
      'position': 3
    }
  ]
};
---

<PageLayout
  image="/og-codes.webp"
  imageAlt={t('nav.codes')}
  title={t('seo.codes.title', { month: currentMonth, year: currentYear })}
  description={t('seo.codes.description', { month: currentMonth, year: currentYear })}
  breadcrumbs={breadcrumbItems}
>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <div class="page-header">
    <h1>{t('seo.codes.h1', { month: currentMonth, year: currentYear })}</h1>
    <p class="subtitle">{t('codes.subtitle')}</p>
  </div>

  <div class="codes-container">
    <section class="codes-section">
      <div class="howto-card">
        <h3>{t('codes.howto.title')}</h3>
        <div class="howto-steps">
          <ol>
            <li>{t('codes.howto.step1')}</li>
            <li>{t('codes.howto.step2')}</li>
            <li>{t('codes.howto.step3')}</li>
          </ol>
        </div>
        <a
          href={giftCenterUrl(lang)}
          target="_blank"
          rel="noopener noreferrer"
          class="redemption-link"
          aria-label={t('codes.giftCenter.ariaLabel')}
        >
          {t('codes.giftCenter')} →
        </a>

        {/* Warum es keinen Knopf gibt, der alles von allein erledigt. Steht
            bewusst hier und nicht im Kleingedruckten: Wer den Vergleich mit
            anderen Seiten zieht, soll den Grund kennen. */}
        <p class="howto-note">{t('codes.howto.noAuto')}</p>
      </div>

      <RewardCodesLocal lang={lang} translationData={translationData} client:visible />
    </section>
  </div>
</PageLayout>

<style>
  .codes-container {
    margin: 0 auto;
    padding: 0 2rem;
  }

  .codes-section {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 165, 0, 0.2);
    border-radius: 12px;
    padding: 2rem;
  }

  .howto-card {
    background: rgba(255, 165, 0, 0.05);
    border: 1px solid rgba(255, 165, 0, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 2rem;
  }

  .howto-card h3 {
    color: #ffa500;
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .howto-steps ol {
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.8;
    margin: 0 0 1.5rem 0;
    padding-left: 1.5rem;
  }

  .howto-steps li {
    margin-bottom: 0.5rem;
  }

  .redemption-link {
    display: inline-block;
    color: #52be80;
    text-decoration: none;
    font-weight: 600;
    padding: 0.5rem 1rem;
    background: rgba(39, 174, 96, 0.1);
    border: 1px solid rgba(39, 174, 96, 0.3);
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .redemption-link:hover {
    background: rgba(39, 174, 96, 0.2);
    border-color: rgba(39, 174, 96, 0.5);
    transform: translateX(4px);
  }

  .howto-note {
    margin: 1.25rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.6);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .codes-section {
      padding: 1.5rem;
    }

    .howto-card {
      padding: 1rem;
    }
  }
</style>
