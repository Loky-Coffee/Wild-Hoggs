---
import PageLayout from '../../layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations, getCurrentMonth, getCurrentYear, getLocalizedPath } from '../../i18n/utils';
import { getLanguagePaths } from '../../i18n/static-paths';
import { loadTranslations } from '../../i18n/index';
import RewardCodesLocal from '../../components/RewardCodesLocal';
import '../../styles/shared-layouts.css';

export function getStaticPaths() {
  return getLanguagePaths();
}

const lang = getLangFromUrl(Astro.url);
const translationData = await loadTranslations(lang);
const t = useTranslations(translationData);
const currentMonth = getCurrentMonth(lang);
const currentYear = getCurrentYear();

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('', lang) },
  { label: t('nav.codes') }
];

// HowTo Schema for SEO
const siteUrl = Astro.site || new URL('https://wild-hoggs.com/');
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  'name': t('codes.howto.title'),
  'description': t('seo.codes.description', { month: currentMonth, year: currentYear }),
  'image': new URL('/og-image.webp', siteUrl).toString(),
  'totalTime': 'PT2M',
  'step': [
    {
      '@type': 'HowToStep',
      'name': t('codes.howto.step1'),
      'text': t('codes.howto.step1'),
      'position': 1
    },
    {
      '@type': 'HowToStep',
      'name': t('codes.howto.step2'),
      'text': t('codes.howto.step2'),
      'position': 2
    },
    {
      '@type': 'HowToStep',
      'name': t('codes.howto.step3'),
      'text': t('codes.howto.step3'),
      'position': 3
    }
  ]
};
---

<PageLayout
  image="/og-codes.webp"
  imageAlt={t('nav.codes')}
  title={t('seo.codes.title', { month: currentMonth, year: currentYear })}
  description={t('seo.codes.description', { month: currentMonth, year: currentYear })}
  breadcrumbs={breadcrumbItems}
>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <div class="page-header">
    <h1>{t('seo.codes.h1', { month: currentMonth, year: currentYear })}</h1>
    <p class="subtitle">{t('codes.subtitle')}</p>
  </div>

  <div class="codes-container">
    <section class="codes-section">
      <div class="howto-card">
        <h3>{t('codes.howto.title')}</h3>
        <div class="howto-steps">
          <ol>
            <li>{t('codes.howto.step1')}</li>
            <li>{t('codes.howto.step2')}</li>
            <li>{t('codes.howto.step3')}</li>
          </ol>
        </div>
        {/* Warum es keinen Knopf gibt, der alles von allein erledigt.
            Zugeklappt, weil es die wenigsten interessiert — aber auffindbar
            für alle, die den Vergleich mit anderen Seiten ziehen. */}
        <details class="howto-note">
          <summary>{t('codes.howto.noAutoTitle')}</summary>
          <p>{t('codes.howto.noAuto')}</p>
        </details>
      </div>

      <!-- client:idle, nicht client:visible: Astro haengt an die Insel ein
           <astro-island>-Element mit display:contents. Das hat keine eigene Flaeche,
           und der IntersectionObserver hinter client:visible bekommt deshalb nie
           zu sehen, dass etwas sichtbar wurde — die Komponente blieb bis zum
           Verlassen der Seite tot. Auf den Rechnerseiten war das schon aufgefallen
           (siehe building.astro), hier stand es noch. -->
      <RewardCodesLocal lang={lang} translationData={translationData} client:idle />
    </section>
  </div>
</PageLayout>

<style>
  .codes-container {
    margin: 0 auto;
    padding: 0 2rem;
  }

  .codes-section {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 165, 0, 0.2);
    border-radius: 12px;
    padding: 2rem;
  }

  /* Bewusst gedrungen: Die Anleitung liest man einmal, die Codes darunter
     sind der Grund fuer den Besuch. */
  .howto-card {
    background: rgba(255, 165, 0, 0.05);
    border: 1px solid rgba(255, 165, 0, 0.2);
    border-radius: 8px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.25rem;
  }

  .howto-card h3 {
    color: #ffa500;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }

  .howto-steps ol {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
    padding-left: 1.2rem;
  }

  .howto-steps li {
    margin-bottom: 0.2rem;
  }


  /* Zugeklappt kostet der Hinweis eine Zeile statt vier. */
  .howto-note {
    margin: 0.75rem 0 0;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.55);
  }

  .howto-note summary {
    cursor: pointer;
    color: rgba(255, 255, 255, 0.7);
  }

  .howto-note summary:hover {
    color: #ffa500;
  }

  .howto-note p {
    margin: 0.5rem 0 0;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2rem;
    }

    .codes-section {
      padding: 1.5rem;
    }

    .howto-card {
      padding: 1rem;
    }
  }
</style>
