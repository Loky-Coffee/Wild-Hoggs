---
/**
 * Ziel des Bestätigungslinks aus der Mail.
 *
 * Wie /reset/: nur über den Link erreichbar, deshalb noindex und aus der
 * Sitemap ausgenommen. Ohne Token gibt es hier nichts zu sehen.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, nurBereiche } from '../../i18n/utils';
import { getLanguagePaths } from '../../i18n/static-paths';
import { loadTranslations } from '../../i18n/index';
import VerifyPage from '../../components/auth/VerifyPage';

export function getStaticPaths() {
  return getLanguagePaths();
}

const lang = getLangFromUrl(Astro.url);
const translationData = await loadTranslations(lang);
const t = useTranslations(translationData);
const homeHref = getLocalizedPath('', lang);
---

<PageLayout
  title={t('verify.title')}
  description={t('verify.checking')}
  robots="noindex, nofollow"
>
  <section class="verify-seite">
    <h1>{t('verify.title')}</h1>
    <VerifyPage
      translationData={nurBereiche(translationData, ['verify.', 'auth.'])}
      homeHref={homeHref}
      client:only="preact"
    />
  </section>
</PageLayout>

<style>
  .verify-seite {
    max-width: 42rem;
    margin: 0 auto;
    padding: 2.5rem 1rem 4rem;
  }

  h1 {
    margin: 0 0 1.5rem;
    font-size: 1.6rem;
    color: #ffa500;
    text-align: center;
  }
</style>
