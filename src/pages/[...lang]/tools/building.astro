---
import PageLayout from '../../../layouts/PageLayout.astro';
import { getLangFromUrl, useTranslations, getLocalizedPath, nurBereiche } from '../../../i18n/utils';
import buildings from '../../../data/buildings.json';
import buildingNames from '../../../data/buildings-names.json';
import { getLanguagePaths } from '../../../i18n/static-paths';
import { loadTranslations } from '../../../i18n/index';
import BuildingCalculator from '../../../components/calculators/BuildingCalculator';
import BuildSpeedButton from '../../../components/calculators/BuildSpeedButton';
import HideDuplicatesButton from '../../../components/calculators/HideDuplicatesButton';
import ResourceSavingButton from '../../../components/calculators/ResourceSavingButton';
import '../../../styles/shared-layouts.css';

export function getStaticPaths() {
  return getLanguagePaths();
}

const lang = getLangFromUrl(Astro.url);
const translationData = await loadTranslations(lang);
const t = useTranslations(translationData);

const breadcrumbItems = [
  { label: t('nav.home'), href: getLocalizedPath('', lang) },
  { label: t('nav.tools'), href: getLocalizedPath('tools', lang) },
  { label: t('tools.building.title') }
];

// Verweise auf die Kostenseiten. Sie tragen den Inhalt, den dieser Rechner im
// JavaScript versteckt — und ohne Verweise fände sie niemand, auch Google nicht.
const namenTabelle = buildingNames as Record<string, Record<string, string>>;
const gebaeudeListe = (buildings as { id: string }[]).map(b => ({
  id: b.id,
  name: namenTabelle[b.id]?.[lang] ?? namenTabelle[b.id]?.en ?? b.id,
})).sort((a, b) => a.name.localeCompare(b.name, lang));
---

<PageLayout title={t('seo.building.title')} description={t('seo.building.description')} breadcrumbs={breadcrumbItems} image="/og-building.webp" imageAlt={t('tools.building.title')}>
  <div class="page-header">
    <h1>{t('tools.building.title')}</h1>
    <p class="subtitle">{t('tools.building.description')}</p>
    <div class="bld-header-controls">
      <BuildSpeedButton lang={lang} client:idle />
      <HideDuplicatesButton labelHide={t('calc.building.hideDuplicates')} labelShow={t('calc.building.showAll')} client:idle />
      <ResourceSavingButton
        label={t('calc.building.saving')}
        title={t('calc.building.savingTitle')}
        note={t('calc.building.savingNote')}
        levelWord={t('calc.building.savingLevel')}
        offWord={t('calc.building.savingOff')}
        client:idle
      />
    </div>
  </div>

  <!-- client:idle ist hier ABSICHTLICH (nicht client:visible):
       IntersectionObserver (genutzt von client:visible) erkennt die Komponente
       im aktuellen Layout-Kontext nie als sichtbar → Hydration startet nie →
       Calculate-Button funktioniert nicht. Gleiches Problem wie tank.astro (9aaeb6f). 

       client:load war die frühere Wahl, kostet aber beim Seitenwechsel: Das
       Bündel wird sofort ausgeführt und blockiert die Darstellung. Gemessen
       lagen Rechnerseiten dadurch bei 300–700 ms, Seiten mit client:visible
       (Codes, Rosen) bei 8–16 ms. client:idle hydriert ebenso garantiert,
       wartet aber auf einen Leerlaufmoment — und braucht keinen
       IntersectionObserver, also besteht das Problem oben nicht. -->
    <BuildingCalculator lang={lang} translationData={nurBereiche(translationData, ['calc.', 'buildings.', 'error.', 'a11y.'])} client:idle />

    <section class="bld-datenlinks">
      <h2>{t('rdata.buildingsHeading')}</h2>
      <ul>
        {gebaeudeListe.map(b => (
          <li><a href={getLocalizedPath(`tools/building/${b.id}/costs`, lang)}>{b.name}</a></li>
        ))}
      </ul>
    </section>
</PageLayout>

<style>
  /* Bau-Speed-Button sitzt im Header -> weniger Abstand zum Rechner (Research hat die
     Übersicht im Header, hier ist der Rechner separat). */
  .page-header { margin-bottom: 1.2rem; }

  .bld-datenlinks {
    margin: 2.5rem auto 0;
    max-width: 1100px;
    padding: 1rem 0 0;
    border-top: 1px solid rgba(255, 165, 0, 0.15);
  }

  .bld-datenlinks h2 {
    font-size: 1rem;
    color: #ffa500;
    margin: 0 0 0.6rem;
  }

  .bld-datenlinks ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.3rem 1rem;
  }

  .bld-datenlinks a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .bld-datenlinks a:hover { color: #ffa500; }
  .bld-header-controls {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>

